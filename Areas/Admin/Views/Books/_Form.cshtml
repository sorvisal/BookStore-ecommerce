@model E_Commerce.Areas.Admin.ViewModels.BookFormViewModel
@{
    var isEdit = Model.BookId.HasValue;
    var cover = !string.IsNullOrWhiteSpace(Model.ImageUrl) ? Model.ImageUrl : "/images/placeholder.svg";
}

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.BookId : null)"
      method="post" enctype="multipart/form-data" id="bookForm">
    @if (isEdit)
    {
        <input type="hidden" asp-for="BookId" />
        <input type="hidden" asp-for="ImageUrl" />
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="adm-panel">
                <h5>Book information</h5>
                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="ISBN" class="form-label"></label>
                        <input asp-for="ISBN" class="form-control" />
                        <span asp-validation-for="ISBN" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Language" class="form-label"></label>
                        <input asp-for="Language" class="form-control" />
                        <span asp-validation-for="Language" class="text-danger small"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="Pages" class="form-label"></label>
                        <input asp-for="Pages" class="form-control" type="number" />
                        <span asp-validation-for="Pages" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PublishYear" class="form-label"></label>
                        <input asp-for="PublishYear" class="form-control" type="number" />
                        <span asp-validation-for="PublishYear" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PublishedDate" class="form-label"></label>
                        <input asp-for="PublishedDate" class="form-control" type="date" />
                        <span asp-validation-for="PublishedDate" class="text-danger small"></span>
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label">Category</label>
                        <select asp-for="CategoryId" class="form-select">
                            <option value="">-- choose --</option>
                            @foreach (var c in Model.Categories)
                            {
                                <option value="@c.CategoryId">@c.CategoryName</option>
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PublisherId" class="form-label">Publisher</label>
                        <select asp-for="PublisherId" class="form-select">
                            <option value="">-- choose --</option>
                            @foreach (var p in Model.Publishers)
                            {
                                <option value="@p.PublisherId">@p.PublisherName</option>
                            }
                        </select>
                        <span asp-validation-for="PublisherId" class="text-danger small"></span>
                    </div>
                </div>
                <label class="form-label">Authors</label>
                <div class="auth-box">
                    @foreach (var a in Model.Authors)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="SelectedAuthorIds"
                                   value="@a.AuthorId" id="au-@a.AuthorId"
                                   checked="@Model.SelectedAuthorIds.Contains(a.AuthorId)" />
                            <label class="form-check-label" for="au-@a.AuthorId">@a.FullName</label>
                        </div>
                    }
                    @if (!Model.Authors.Any())
                    {
                        <span class="text-muted small">No authors yet. Add them under the Authors menu first.</span>
                    }
                </div>
            </div>

            <div class="adm-panel">
                <h5>Pricing and stock</h5>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="Price" class="form-label"></label>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DiscountPrice" class="form-label"></label>
                        <input asp-for="DiscountPrice" class="form-control" type="number" step="0.01" min="0" />
                        <span asp-validation-for="DiscountPrice" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="StockQuantity" class="form-label"></label>
                        <input asp-for="StockQuantity" class="form-control" type="number" min="0" />
                        <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                    </div>
                </div>
                <div class="form-check form-switch">
                    <input asp-for="Status" class="form-check-input" />
                    <label asp-for="Status" class="form-check-label"></label>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="adm-panel">
                <h5>Cover image</h5>
                <div class="text-center mb-3">
                    <img id="coverPreview" src="@cover" alt="Cover preview" class="cover-preview"
                         onerror="this.src='/images/placeholder.svg'" />
                </div>
                <input asp-for="CoverFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp" />
                <span asp-validation-for="CoverFile" class="text-danger small"></span>
                <div class="text-muted small mt-1">JPG, PNG or WEBP, max 2 MB.</div>
            </div>

            <button type="submit" class="btn-adm w-100" id="bookSubmit"><i class="bi bi-check-lg"></i> Save book</button>
            <a class="btn btn-outline-secondary w-100 mt-2" asp-action="Index">Cancel</a>
        </div>
    </div>
</form>

<script>
    (function () {
        // Live cover preview
        var input = document.getElementById('CoverFile');
        var preview = document.getElementById('coverPreview');
        if (input) {
            input.addEventListener('change', function () {
                var f = input.files && input.files[0];
                if (!f) return;
                var reader = new FileReader();
                reader.onload = function (e) { preview.src = e.target.result; };
                reader.readAsDataURL(f);
            });
        }

        // Disable the submit button with a spinner on submit
        var form = document.getElementById('bookForm');
        var btn = document.getElementById('bookSubmit');
        form.addEventListener('submit', function () {
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Saving...';
        });
    })();
</script>
