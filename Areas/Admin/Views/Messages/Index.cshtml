@model List<Contact>
@{
    ViewData["Title"] = "Messages";
}

<div class="adm-panel table-responsive">
    <table class="table adm-table align-middle">
        <thead>
            <tr><th>Date</th><th>From</th><th>Subject</th><th></th></tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="4" class="text-center text-muted py-4">No messages yet.</td></tr>
            }
            @foreach (var m in Model)
            {
                <tr>
                    <td class="text-nowrap">@m.CreatedAt.ToString("dd MMM yyyy, HH:mm")</td>
                    <td>
                        <div class="fw-semibold">@m.FullName</div>
                        <small class="text-muted">@m.Email</small>
                    </td>
                    <td>@m.Subject</td>
                    <td class="text-nowrap text-end">
                        <button type="button" class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#msg-@m.ContactId">
                            <i class="bi bi-eye"></i> Read
                        </button>
                        <form asp-action="Delete" asp-route-id="@m.ContactId" method="post" class="d-inline"
                              onsubmit="return confirm('Delete this message?')">
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash3"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@foreach (var m in Model)
{
    <div class="modal fade" id="msg-@m.ContactId" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title">@m.Subject</h5>
                        <small class="text-muted">@m.FullName &middot; @m.Email &middot; @m.CreatedAt.ToString("dd MMM yyyy, HH:mm")</small>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="white-space: pre-wrap;">@m.Message</div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}
