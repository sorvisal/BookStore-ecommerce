@model E_Commerce.Areas.Admin.ViewModels.AdminUserListViewModel
@{
    ViewData["Title"] = "Users";
}

<div class="adm-summary mb-3">
    <span><i class="bi bi-people"></i> <b>@Model.TotalUsers</b> users</span>
    <span><i class="bi bi-shield-check"></i> <b>@Model.TotalAdmins</b> admins</span>
    <span><i class="bi bi-person"></i> <b>@Model.TotalCustomers</b> customers</span>
    <span><i class="bi bi-person-x"></i> <b>@Model.TotalInactive</b> inactive</span>
</div>

<div class="adm-panel">
    <form method="get" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small mb-1">Search</label>
            <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Name, email or phone" />
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1">Role</label>
            <select name="role" class="form-select">
                <option value="">All</option>
                <option value="Admin" selected="@(Model.Role == "Admin")">Admin</option>
                <option value="Customer" selected="@(Model.Role == "Customer")">Customer</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1">Status</label>
            <select name="status" class="form-select">
                <option value="">All</option>
                <option value="active" selected="@(Model.Status == "active")">Active</option>
                <option value="inactive" selected="@(Model.Status == "inactive")">Inactive</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn-adm w-100"><i class="bi bi-funnel"></i> Filter</button>
        </div>
        <div class="col-md-2 text-md-end">
            <a class="btn-adm w-100" asp-action="Create"><i class="bi bi-plus-lg"></i> New user</a>
        </div>
    </form>
</div>

<div class="adm-panel table-responsive">
    <table class="table adm-table align-middle">
        <thead>
            <tr>
                <th>User</th>
                <th>Phone</th>
                <th>Role</th>
                <th>Status</th>
                <th>Orders</th>
                <th>Total spent</th>
                <th>Joined</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-4">No users found.</td></tr>
            }
            @foreach (var u in Model.Items)
            {
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <partial name="_Avatar" model="u.Avatar" />
                            <div>
                                <div class="fw-semibold">@u.FullName</div>
                                <small class="text-muted">@u.Email</small>
                            </div>
                        </div>
                    </td>
                    <td>@(u.Phone ?? "-")</td>
                    <td><span class="pay-badge @(u.Role == "Admin" ? "paid" : "unpaid")">@u.Role</span></td>
                    <td>
                        <form asp-action="ToggleStatus" asp-route-id="@u.UserId" method="post">
                            <button type="submit" class="pay-badge border-0 @(u.Status ? "paid" : "unpaid")" title="Click to toggle">
                                @(u.Status ? "Active" : "Inactive")
                            </button>
                        </form>
                    </td>
                    <td>@u.OrderCount</td>
                    <td class="fw-bold">$@u.TotalSpent.ToString("N2")</td>
                    <td>@(u.CreatedAt?.ToString("dd MMM yyyy") ?? "-")</td>
                    <td class="text-nowrap text-end">
                        <a class="btn btn-sm btn-outline-success" asp-action="Edit" asp-route-id="@u.UserId" title="Edit"><i class="bi bi-pencil"></i></a>
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Reset password"
                                data-bs-toggle="modal" data-bs-target="#pwd-@u.UserId"><i class="bi bi-key"></i></button>
                        <button type="button" class="btn btn-sm btn-outline-danger" title="Delete"
                                data-bs-toggle="modal" data-bs-target="#del-@u.UserId"><i class="bi bi-trash3"></i></button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination pagination-sm">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                       asp-route-role="@Model.Role" asp-route-status="@Model.Status" asp-route-page="@p">@p</a>
                </li>
            }
        </ul>
    </nav>
}

@foreach (var u in Model.Items)
{
    <div class="modal fade" id="pwd-@u.UserId" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="ResetPassword" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title">Reset password</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="small text-muted">Set a new password for <b>@u.FullName</b> (@u.Email).</p>
                        <input type="hidden" name="id" value="@u.UserId" />
                        <input type="password" name="newPassword" class="form-control" minlength="6" required placeholder="New password (min 6 characters)" />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn-adm"><i class="bi bi-key"></i> Reset password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="del-@u.UserId" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete user</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Delete <b>@u.FullName</b> (@u.Email)? This also removes their cart, cart items and reviews.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form asp-action="Delete" asp-route-id="@u.UserId" method="post">
                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash3"></i> Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
