@model List<AdminCustomerRow>
@{
    ViewData["Title"] = "Customers";
    var search = (string?)ViewData["Search"];
    var page = (int)ViewData["Page"]!;
    var totalPages = (int)ViewData["TotalPages"]!;
}

<div class="adm-panel">
    <form method="get" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label small mb-1">Search</label>
            <input type="text" name="search" value="@search" class="form-control" placeholder="Name or email" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn-adm w-100"><i class="bi bi-search"></i> Search</button>
        </div>
    </form>
</div>

<div class="adm-panel table-responsive">
    <table class="table adm-table align-middle">
        <thead>
            <tr><th>Customer</th><th>Phone</th><th>Joined</th><th>Orders</th><th>Total spent</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">No customers found.</td></tr>
            }
            @foreach (var c in Model)
            {
                <tr>
                    <td>
                        <div class="fw-semibold">@c.FullName</div>
                        <small class="text-muted">@c.Email</small>
                    </td>
                    <td>@(c.Phone ?? "-")</td>
                    <td>@(c.CreatedAt?.ToString("dd MMM yyyy") ?? "-")</td>
                    <td>@c.OrderCount</td>
                    <td class="fw-bold">$@c.TotalSpent.ToString("N2")</td>
                    <td>
                        @if (c.Status)
                        {
                            <span class="pay-badge paid">Active</span>
                        }
                        else
                        {
                            <span class="pay-badge unpaid">Inactive</span>
                        }
                    </td>
                    <td class="text-end">
                        <form asp-action="ToggleStatus" method="post" class="d-inline"
                              onsubmit="return confirm('@(c.Status ? "Deactivate" : "Activate") this account?')">
                            <input type="hidden" name="id" value="@c.UserId" />
                            @if (c.Status)
                            {
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-person-x"></i> Deactivate</button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-outline-success"><i class="bi bi-person-check"></i> Activate</button>
                            }
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    <nav>
        <ul class="pagination pagination-sm">
            @for (var p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-search="@search" asp-route-page="@p">@p</a>
                </li>
            }
        </ul>
    </nav>
}
