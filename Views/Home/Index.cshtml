@{
    ViewData["Title"] = "ទំព័រដើម";
}

<div class="custom-width mt-4">
    <!-- ផ្នែក Hero Banner -->
    <div class="p-4 mb-4 bg-light rounded-3 shadow-sm border">
        <div class="container-fluid py-2">
            <div class="row align-items-center">
                <!-- ផ្នែកអត្ថបទ (ខាងឆ្វេង) -->
                <div class="col-md-7">
                    <h1 class="display-6 fw-bold text-primary">ស្វាគមន៍មកកាន់ E-Commerce សៀវភៅ</h1>
                    <p class="fs-5 mt-3">
                        ស្វែងរកសៀវភៅល្អៗ និងអ្នកនិពន្ធល្បីៗជាច្រើននៅទីនេះ។ យើងផ្តល់ជូននូវបទពិសោធន៍អានដ៏អស្ចារ្យសម្រាប់អ្នក។
                    </p>
                    <button class="btn btn-primary btn-lg mt-3" type="button">ស្វែងរកសៀវភៅឥឡូវនេះ</button>
                </div>

                <!-- ផ្នែករូបភាព (ខាងស្តាំ) -->
                <div class="col-md-5 text-center mt-4 mt-md-0">
                    <img src="~/images/slide-pic.webp" class="img-fluid rounded shadow-sm" alt="Book Banner" style="max-height: 250px;">
                </div>
            </div>
        </div>
    </div>

    <!-- ផ្នែកបង្ហាញចំណាត់ថ្នាក់ ឬសៀវភៅលេចធ្លោ (Grid View) -->
    <div class="row mt-5 g-4">
        <h3 class="mb-3 border-bottom pb-2">សៀវភៅពេញនិយមប្រចាំសប្តាហ៍</h3>

        <!-- កាតទី១ -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 bg-light">
                <div class="card-body text-center">
                    <h5 class="card-title fw-bold">ប្រលោមលោក</h5>
                    <p class="card-text text-muted">សៀវភៅប្រលោមលោកថ្មីៗជាច្រើនកំពុងរង់ចាំអ្នក។</p>
                    <a href="#" class="btn btn-outline-primary mt-2">មើលបន្ថែម</a>
                </div>
            </div>
        </div>

        <!-- កាតទី២ -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 bg-light">
                <div class="card-body text-center">
                    <h5 class="card-title fw-bold">បច្ចេកវិទ្យា & IT</h5>
                    <p class="card-text text-muted">សៀវភៅទាក់ទងនឹងការសរសេរកូដ និងការអភិវឌ្ឍកម្មវិធី។</p>
                    <a href="#" class="btn btn-outline-primary mt-2">មើលបន្ថែម</a>
                </div>
            </div>
        </div>

        <!-- កាតទី៣ -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 bg-light">
                <div class="card-body text-center">
                    <h5 class="card-title fw-bold">ប្រវត្តិសាស្ត្រ</h5>
                    <p class="card-text text-muted">សិក្សាពីអតីតកាល ដើម្បីស្វែងយល់ពីបច្ចុប្បន្ន។</p>
                    <a href="#" class="btn btn-outline-primary mt-2">មើលបន្ថែម</a>
                </div>
            </div>
        </div>
    </div>
</div>
