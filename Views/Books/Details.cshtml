@using Microsoft.Extensions.Localization
@using E_Commerce
@inject IStringLocalizer<SharedResource> L
@model E_Commerce.ViewModels.BookDetailsViewModel
@{
    ViewData["Title"] = Model.Book.Title;
    var authors = string.Join(", ", Model.Authors.Select(a => a.FullName));
    var img = !string.IsNullOrWhiteSpace(Model.Book.ImageUrl) ? Model.Book.ImageUrl : (!string.IsNullOrWhiteSpace(Model.Book.CoverImage) ? Model.Book.CoverImage : "/images/placeholder.svg");
    var qtyLabel = L["Quantity"].Value;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            <div class="text-center">
                <img src="@img" class="img-fluid shadow-sm" alt="@Model.Book.Title" onerror="this.src='/images/placeholder.svg'">
            </div>
        </div>
        <div class="col-md-8">
            <h3>@Model.Book.Title</h3>
            @if (!string.IsNullOrEmpty(authors))
            {
                <p class="text-muted">@L["by"] @authors</p>
            }
            <div class="mb-2">
                <strong>@L["Category"]:</strong> @(Model.Book.Category?.CategoryName ?? "-")
                @if (Model.Book.Publisher != null)
                {
                    <span class="ms-2"><strong>@L["Publisher"]:</strong> @Model.Book.Publisher.PublisherName</span>
                }
            </div>
            <div class="mb-3">
                @if (Model.Book.DiscountPrice.HasValue)
                {
                    <span class="h4 text-primary">$@Model.Book.DiscountPrice.Value.ToString("0.00")</span>
                    <span class="text-muted text-decoration-line-through ms-2">$@Model.Book.Price.ToString("0.00")</span>
                }
                else
                {
                    <span class="h4 text-primary">$@Model.Book.Price.ToString("0.00")</span>
                }
            </div>
            @if (Model.Book.StockQuantity <= 0)
            {
                <div class="alert alert-danger">@L["Out of stock"]</div>
            }
            else
            {
                <div class="text-success small mb-2"><i class="bi bi-check-circle"></i> @L["In stock"]</div>
                <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex align-items-center gap-2 mb-3">
                    <input type="hidden" name="bookId" value="@Model.Book.BookId" />
                    <input type="number" name="quantity" value="1" min="1" max="@Model.Book.StockQuantity" class="form-control" style="width:90px" aria-label="@qtyLabel" />
                    <button type="submit" class="btn btn-accent"><i class="bi bi-cart-plus"></i> @L["Add to cart"]</button>
                </form>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Book.Description))
            {
                <div class="mb-3">
                    <h5>@L["Description"]</h5>
                    <p>@Model.Book.Description</p>
                </div>
            }
        </div>
    </div>

    <hr class="my-4" />

    <div class="row">
        <div class="col-md-8">
            <h5>@L["Reviews"] (@Model.Reviews.Count) - @L["Average"]: <span class="text-warning">@for (var s = 1; s <= 5; s++)
{
    var halfAvg = (int)Math.Round(Model.AverageRating * 2);
    var cls = halfAvg >= s * 2 ? "bi-star-fill" : (halfAvg >= s * 2 - 1 ? "bi-star-half" : "bi-star");
    <i class="bi @cls"></i>
}</span> @Model.AverageRating.ToString("0.0")</h5>
            @if (!Model.Reviews.Any())
            {
                <p class="text-muted">@L["No reviews yet."]</p>
            }
            @foreach (var r in Model.Reviews)
            {
                <div class="border-bottom py-2">
                    <strong>@r.UserName</strong> - <span class="text-warning">@for (var s = 1; s <= 5; s++)
{
    <i class="bi @(s <= (r.Rating ?? 0) ? "bi-star-fill" : "bi-star")"></i>
}</span> <small class="text-muted">@r.CreatedAt.ToString("MMM dd, yyyy")</small>
                    @if (!string.IsNullOrWhiteSpace(r.Comment))
                    {
                        <p class="mb-0">@r.Comment</p>
                    }
                </div>
            }

            @if (Model.CanReview)
            {
                <h6 class="mt-3">@L["Write a review"]</h6>
                <form asp-action="AddReview" method="post" id="reviewForm">
                    <input type="hidden" asp-for="NewReview.BookId" />
                    <div class="mb-2">
                        <label class="form-label">@L["Rating"]</label>
                        <div class="star-picker" id="starPicker" role="radiogroup" aria-label="@L["Rating"]">
                            @for (var i = 1; i <= 5; i++)
                            {
                                <button type="button" class="star-btn" data-value="@i" role="radio" aria-checked="false" aria-label="@i"><i class="bi bi-star-fill"></i></button>
                            }
                        </div>
                        <input type="hidden" name="NewReview.Rating" id="ratingInput" value="@(Model.NewReview?.Rating ?? 0)" />
                        <div class="text-danger small mt-1 d-none" id="ratingError" data-text="@L["Please choose a rating from 1 to 5 stars."]"></div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">@L["Comment"]</label>
                        <textarea asp-for="NewReview.Comment" class="form-control" rows="3"></textarea>
                    </div>
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary">@L["Submit"]</button>
                </form>
            }
        </div>
        <div class="col-md-4">
            @if (Model.RelatedBooks.Any())
            {
                <h5>@L["You may also like"]</h5>
                @foreach (var b in Model.RelatedBooks)
                {
                    <a asp-action="Details" asp-route-id="@b.BookId" class="text-decoration-none text-dark">
                        <div class="d-flex mb-2">
                            <img src="@(!string.IsNullOrWhiteSpace(b.ImageUrl) ? b.ImageUrl : (!string.IsNullOrWhiteSpace(b.CoverImage) ? b.CoverImage : "/images/placeholder.svg"))" class="me-2" style="width:60px; height:80px; object-fit:cover;" onerror="this.src='/images/placeholder.svg'">
                            <div>
                                <div>@b.Title</div>
                                @if (b.DiscountPrice.HasValue)
                                {
                                    <small class="text-primary">$@b.DiscountPrice.Value.ToString("0.00")</small>
                                    <small class="text-muted text-decoration-line-through">$@b.Price.ToString("0.00")</small>
                                }
                                else
                                {
                                    <small class="text-primary">$@b.Price.ToString("0.00")</small>
                                }
                            </div>
                        </div>
                    </a>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var picker = document.getElementById('starPicker');
            if (!picker) return;
            var buttons = Array.prototype.slice.call(picker.querySelectorAll('.star-btn'));
            var input = document.getElementById('ratingInput');
            var errorEl = document.getElementById('ratingError');
            var form = document.getElementById('reviewForm');

            function paint(n) {
                buttons.forEach(function (b) {
                    var v = Number(b.getAttribute('data-value'));
                    b.classList.toggle('active', v <= n);
                    b.setAttribute('aria-checked', v === (Number(input.value) || 0) ? 'true' : 'false');
                });
            }

            paint(Number(input.value) || 0);

            function select(v) {
                input.value = v;
                paint(v);
                errorEl.classList.add('d-none');
            }

            buttons.forEach(function (b) {
                var v = Number(b.getAttribute('data-value'));
                b.addEventListener('click', function () { select(v); });
                b.addEventListener('mouseenter', function () { paint(v); });
                b.addEventListener('focus', function () { paint(v); });
                b.addEventListener('keydown', function (e) {
                    var cur = Number(input.value) || 0;
                    if (e.key === 'ArrowRight' || e.key === 'ArrowUp') { e.preventDefault(); select(Math.min(5, (cur || 0) + 1)); buttons[Math.min(5, (cur || 0) + 1) - 1].focus(); }
                    else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') { e.preventDefault(); select(Math.max(1, (cur || 1) - 1)); buttons[Math.max(1, (cur || 1) - 1) - 1].focus(); }
                    else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); select(v); }
                });
            });
            picker.addEventListener('mouseleave', function () { paint(Number(input.value) || 0); });

            form.addEventListener('submit', function (e) {
                var v = Number(input.value);
                if (!Number.isInteger(v) || v < 1 || v > 5) {
                    e.preventDefault();
                    errorEl.textContent = errorEl.getAttribute('data-text');
                    errorEl.classList.remove('d-none');
                    buttons[0].focus();
                    buttons[0].scrollIntoView({ block: 'center', behavior: 'smooth' });
                }
            });
        })();
    </script>
}
