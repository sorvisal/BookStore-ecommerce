@using Microsoft.Extensions.Localization
@using E_Commerce
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = "Access Denied";
}
<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<div class="au-wrap au-solo">
    <section class="au-form-side">
        <div class="au-bubble"><i class="bi bi-shield-lock"></i></div>
        <h1 class="au-title">@L["Access denied"]</h1>
        <p class="au-sub">@L["You do not have permission to view this page."]</p>

        <div class="au-actions">
            <a class="au-btn" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> @L["Back to Home"]</a>
            <a class="au-btn ghost" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right"></i> @L["Login"]</a>
        </div>
    </section>
</div>
